# Copier vers .env puis adapter. Ne JAMAIS committer .env.

# Rôle applicatif (soumis à la RLS)
DATABASE_URL=postgresql+psycopg://agent24_app:app_pw@localhost:5432/agent24
# Rôle propriétaire (migrations et scripts d'administration uniquement)
MIGRATIONS_DATABASE_URL=postgresql+psycopg://agent24_owner:owner_pw@localhost:5432/agent24

# Application Meta (une seule pour toute la plateforme, les pages des clients s'y connectent)
META_APP_SECRET=remplacer_par_le_secret_de_l_app_meta
MESSENGER_VERIFY_TOKEN=une_chaine_aleatoire_longue

# Clé Fernet pour chiffrer les jetons des canaux au repos :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

LOG_LEVEL=INFO

# Worker / agent
APP_ENV=production                # "development" autorise Groq ; en production, seul Anthropic est accepté
LLM_PROVIDER=anthropic            # anthropic | groq (groq : développement uniquement)
ANTHROPIC_API_KEY=
GROQ_API_KEY=                     # développement uniquement
GROQ_BASE_URL=https://api.groq.com/openai/v1
AGENT_MODEL=claude-sonnet-5-5     # modèle par défaut ; surchargeable par client (config.agent.model)
GRAPH_API_VERSION=v23.0           # à vérifier dans le changelog Meta
SEND_MODE=console                 # "console" : affiche les réponses ; "messenger" : envoie vraiment

# Tableau de bord (session 3)
DASHBOARD_ORIGIN=https://app.exemple.com       # origine exacte du tableau de bord (CORS + contrôle d'Origin)
DASHBOARD_BASE_URL=https://app.exemple.com     # base des liens dans les emails
COOKIE_SECURE=true                             # false uniquement en développement sans HTTPS
COOKIE_SAMESITE=lax                            # API et tableau de bord sur le même site (ex. api.x.com / app.x.com)
SESSION_HOURS=12
META_APP_ID=                                   # identifiant de l'app Meta (détection des réponses humaines)

# Email de notification d'escalade
EMAIL_MODE=console                             # "console" : affiche ; "smtp" : envoie vraiment
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls                         # starttls | ssl | none
EMAIL_FROM=Agent24 <notifications@exemple.com>
